APP_NAME=职向 · 智能就业分析助手
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_database_password
MYSQL_DATABASE=bossinfo
MYSQL_TABLE=jobinfo

# 未配置 API Key 时自动使用能力有限的演示模式；生产环境建议设为 false。
ALLOW_DEMO=true
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 请填写你的账号实际可用的模型 ID，不假设 Kimi k3 已开放。
KIMI_MODEL=
LLM_TIMEOUT_SECONDS=60
SQL_MAX_ATTEMPTS=3
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000

# hash: 离线词面向量演示，不具备语义理解；sentence_transformers: 真实本地语义模型；api: Embedding 服务。
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CPU_THREADS=4
INDEX_DIR=data/index
RAG_TOP_K=5
RAG_CANDIDATES=30
CHUNK_MAX_CHARS=500
CHUNK_SEMANTIC_THRESHOLD=0.55
# 可选：设置后 /api/* 需要 X-API-Key；适用于非本机部署。
SERVICE_API_KEY=
